# -------------------------------------------------------------------
# App / Next.js
# -------------------------------------------------------------------

NODE_ENV=development

# Local URL for your app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# Optional, for variable usage
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000


# -------------------------------------------------------------------
# Payload
# -------------------------------------------------------------------

# Important: required for auth, sessions, tokens, etc.
# Please replace this with your own random value later.
PAYLOAD_SECRET=thisIsTheSecretKeyForYourPayloadApp

# Some Payload projects expect DATABASE_URI,
# others expect DATABASE_URL. I keep both here to make sure your project starts reliably.
DATABASE_URI=kistlboard://kistlboard:kistlboard@localhost:5432/cms
DATABASE_URL=kistlboard://kistlboard:kistlboard@localhost:5432/cms
